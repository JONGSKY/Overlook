# Overlook — environment variables
#
# Copy this file to .env and fill in the values.
# On Vercel, set these in the dashboard under Settings → Environment Variables.
# Never commit the .env file.

# Optional: GitHub Personal Access Token for higher API rate limits (5000 req/h instead of 60).
# Required for auditing private repositories.
# Scope needed: "repo" for private repos, or no scope for public repos only.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Set automatically by Vercel. Do not set manually.
# VERCEL=1
