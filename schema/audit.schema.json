{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Overlook audit",
  "description": "audit.json written by Bob in Overlook Auditor mode (SPEC 3.2). Bob interprets: fence, claims, plain language, screens. Verdicts of git-checkable claims are ignored and recomputed by build-city.mjs.",
  "type": "object",
  "required": ["kind", "request", "fence", "districts", "bobReport", "claims", "plain", "screens"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "overlook.audit/v1" },
    "sample": { "type": "boolean", "description": "true only for scripted sample data" },
    "draft": { "type": "boolean", "description": "true when built from typed text, not by the Overlook Auditor mode" },
    "example": {
      "type": "object",
      "description": "A real task from a public repository audited as an example (samples/real/). The request and the agent's report are quoted from the source; the fence and the claim types were written by a person, not by Bob.",
      "required": ["kind", "repo", "url", "auditor"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "description": "e.g. \"Bob task\" or \"Copilot agent PR\"" },
        "repo": { "type": "string", "description": "owner/name" },
        "url": { "type": "string", "description": "the pull request, commit or session file the task comes from" },
        "context": { "type": "string", "description": "why this example, e.g. \"IBM Bob Hackathon (May 2026), 2nd place\"" },
        "auditor": { "type": "string", "description": "who wrote the fence and claim types" },
        "license": { "type": "string" },
        "redacted": { "type": "boolean", "description": "true when diffs were left out (no license to redistribute the code)" }
      }
    },
    "request": {
      "type": "object",
      "required": ["id", "title", "scope"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "$ref": "#/$defs/text" },
        "scope": { "$ref": "#/$defs/text" },
        "source": { "type": "string", "description": "path of the brief" }
      }
    },
    "fence": {
      "type": "object",
      "required": ["paths", "rationale"],
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "description": "directories end with /" }
        },
        "rationale": { "$ref": "#/$defs/text", "description": "one sentence quoting the brief" }
      }
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "label"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "/$", "description": "directory, ending with /" },
          "label": { "$ref": "#/$defs/text" }
        }
      }
    },
    "bobReport": { "$ref": "#/$defs/text", "description": "the agent's final report, verbatim" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "type"],
        "additionalProperties": false,
        "properties": {
          "text": { "$ref": "#/$defs/text", "description": "verbatim substring of bobReport" },
          "type": { "enum": ["scope", "no_api_change", "tests_pass", "no_new_files", "only_files", "feature"] },
          "files": { "type": "array", "items": { "type": "string" }, "description": "only for only_files" },
          "verdict": { "enum": ["true", "false", "partial", "unverified"], "description": "feature only" },
          "note": { "$ref": "#/$defs/text", "description": "feature only" },
          "check": {
            "type": "object",
            "description": "feature only: an executable check Overlook runs on head; its exit code decides the verdict",
            "required": ["command"],
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string", "minLength": 1, "description": "shell command run at the repository root, exit 0 = the claim holds" },
              "why": { "type": "string", "description": "what the check proves, one sentence" }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "only_files" } } },
            "then": { "required": ["files"] }
          },
          {
            "if": { "properties": { "type": { "const": "feature" } } },
            "then": { "required": ["verdict", "note"] },
            "else": { "not": { "anyOf": [{ "required": ["verdict"] }, { "required": ["note"] }] } }
          }
        ]
      }
    },
    "plain": {
      "type": "object",
      "description": "plain-language explanation per file path",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "detail"],
        "additionalProperties": false,
        "properties": {
          "title": { "$ref": "#/$defs/text", "description": "under 12 words" },
          "detail": { "$ref": "#/$defs/text", "description": "under 20 words" }
        }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "label", "title", "before", "after"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string" },
          "label": { "$ref": "#/$defs/text" },
          "title": { "$ref": "#/$defs/text" },
          "who": { "$ref": "#/$defs/text" },
          "before": { "$ref": "#/$defs/screenContent" },
          "after": { "$ref": "#/$defs/screenContent" }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "description": "A string, or the same text in English and Korean (the UI falls back to en).",
      "anyOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["en"],
          "additionalProperties": false,
          "properties": {
            "en": { "type": "string" },
            "ko": { "type": "string" }
          }
        }
      ]
    },
    "screenContent": {
      "anyOf": [
        { "$ref": "#/$defs/text" },
        {
          "type": "object",
          "required": ["img"],
          "additionalProperties": false,
          "properties": { "img": { "type": "string", "description": "image path" } }
        }
      ]
    }
  }
}
